<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhimian.mapper.InterviewMessageMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO interview_message (session_id,role,content,tokens)
        VALUES (#{sessionId},#{role},#{content},#{tokens})
    </insert>

    <select id = "selectBySessionId" resultType="com.zhimian.model.entity.InterviewMessage">
        SELECT id,session_id,role,content,tokens,create_time
        FROM interview_message
        WHERE session_id = #{sessionId}
        ORDER BY id ASC
    </select>

    <select id="selectLastAssistantBySessionId" resultType="com.zhimian.model.entity.InterviewMessage">
        SELECT id, session_id, role, content, tokens, create_time
        FROM interview_message
        WHERE session_id = #{sessionId}
          AND role = 'assistant'
        ORDER BY id DESC
        LIMIT 1
    </select>
</mapper>
