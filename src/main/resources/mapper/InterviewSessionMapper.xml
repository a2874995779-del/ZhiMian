<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhimian.mapper.InterviewSessionMapper">
    <insert id="insert" keyProperty="id" useGeneratedKeys="true">
        INSERT INTO interview_session (user_id,direction,title,status)
        VALUES (#{userId},#{direction},#{title},#{status})
    </insert>

    <select id="countInProgress" resultType="long">
        SELECT count(*)
        FROM interview_session
        WHERE user_id =#{userId} AND status = 0 AND is_deleted = 0
    </select>
</mapper>